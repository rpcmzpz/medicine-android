<?xml version="1.0" encoding="utf-8"?><!--
  Android 12 及以上的数据提取规则。
  auth_prefs.xml 存 access_token / refresh_token，云备份与换机迁移都排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
